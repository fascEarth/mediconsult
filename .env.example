# Copy to api/.env
DATABASE_URL=postgresql://medi:medi@localhost:5433/mediconsult
PORT=3100
CORS_ORIGINS=http://localhost:4300
APP_URL=http://localhost:4300

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Payments: demo | razorpay
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Video: public Jitsi or your own Jitsi server
JITSI_DOMAIN=meet.jit.si

# Email (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MediConsult <no-reply@mediconsult.local>"

UPLOAD_DIR=./uploads
# Demo mode: banner in UI, demo payments, nightly data reset allowed
DEMO_MODE=true
